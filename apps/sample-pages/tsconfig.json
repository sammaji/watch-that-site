{
    "extends": "@watchthatsite/tsconfig/nextjs.json",
    "compilerOptions": {
        "paths": {
            "@/*": ["./*"],
            "@watchthatsite/ui/styles.css": [
                "../../packages/ui/src/styles/globals.css"
            ],
            "@watchthatsite/ui/*": ["../../packages/ui/src/*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "**/*.mts"
    ]
}

# WatchThatSite environment. `make setup-env` copies this file to .env, fills
# the local secrets marked "generated", and symlinks .env into every app,
# package and service. Values shown are the local-development defaults.

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
# Web app (apps/web, port 3000) and marketing site (apps/site, port 3001).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Docs (apps/docs); the marketing site redirects /docs to it.
NEXT_PUBLIC_DOC_URL=http://localhost:3002
# The sample pages (apps/sample-pages), for the Monitor form's "Try an example".
NEXT_PUBLIC_SAMPLE_PAGES_URL=http://localhost:3003
# PostgREST, as the browser reaches it.
NEXT_PUBLIC_POSTGREST_URL=http://localhost:5201
# Origin used in notification links. Defaults to NEXT_PUBLIC_APP_URL.
WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# generated: `openssl rand -hex 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord sign-in, and the WatchThatSite bot for the Discord Channel.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# The WatchThatSite bot for the Telegram Channel.
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Email (Resend): verification, password reset, the Email Channel
# ---------------------------------------------------------------------------
RESEND_API_KEY=
SMTP_SENDER_NAME=WatchThatSite
SMTP_MAIL=

# ---------------------------------------------------------------------------
# Postgres and PostgREST
# ---------------------------------------------------------------------------
POSTGRES_DATABASE=watchthatsite
POSTGRES_HOST=localhost
POSTGRES_PORT=5200
POSTGRES_USER=postgres
# generated: `openssl rand -hex 24`
POSTGRES_PASSWORD=
# Optional: a full connection string; wins over the POSTGRES_* parts above.
# DATABASE_URL=
PGRST_JWT_AUD=watchthatsite-postgrest
# Better Auth's JWKS, written by `make backfill-jwks`.
PGRST_JWT_SECRET=

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=watchthatsite
# generated: `openssl rand -hex 24`
RABBITMQ_PASSWORD=

# ---------------------------------------------------------------------------
# Secrets vault and model connections
# ---------------------------------------------------------------------------
# Encrypts model API keys and Macro secrets at rest (AES-256-GCM). 32 bytes as
# 64 hex characters. Losing or changing it makes every stored key unreadable.
# Read by the web app and the browser worker; they must share it.
# generated: `openssl rand -hex 32`
ENCRYPTION_KEY=
# The model gateway requests a connection's base URL, so only public https
# addresses are allowed. `true` also allows http and private or local
# addresses (a server on this machine). Local development and tests only.
ALLOW_PRIVATE_NETWORK=false

# ---------------------------------------------------------------------------
# Model gateway (Bifrost), see "Model gateway and platform credit" in README.md
# ---------------------------------------------------------------------------
# Every model call goes through it. Started by `make docker-up` on :5203.
# Read by the web app (admin API) and the browser worker (inference).
BIFROST_URL=http://localhost:5203
# Admin login for the gateway's dashboard and admin API.
BIFROST_ADMIN_USERNAME=admin
# generated: `openssl rand -hex 24`
BIFROST_ADMIN_PASSWORD=
# The gateway's own Postgres (container watchthatsite-bifrost-postgres).
BIFROST_POSTGRES_DATABASE=bifrost
BIFROST_POSTGRES_USER=bifrost
# generated: `openssl rand -hex 24`
BIFROST_POSTGRES_PASSWORD=
# Our OpenAI key behind the platform credit (the gateway's `wts` provider).
# Never given to anyone: accounts reach it only through their virtual key,
# within their credit.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Agent API (served by the browser worker)
# ---------------------------------------------------------------------------
# Where the browser worker listens.
AGENT_ADDR=127.0.0.1:5220
# Where the scheduler and the web app reach it.
AGENT_URL=http://127.0.0.1:5220
# Bearer token shared by the browser worker, the scheduler and the web app.
# generated: `openssl rand -hex 32`
AGENT_TOKEN=

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# Admin API listen address, and where the web app reaches it.
SCHEDULER_ADMIN_ADDR=:5210
SCHEDULER_ADMIN_URL=http://localhost:5210
# Bearer token for the admin API. Unset turns the API off, and with it Run now
# and the other Monitor actions in the web app.
# generated: `openssl rand -hex 32`
SCHEDULER_ADMIN_TOKEN=
# Days after which Changes and unreferenced Capture objects are deleted.
RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Object storage (Cloudflare R2), see "Object storage" in README.md
# ---------------------------------------------------------------------------
# R2_WORKER_URL: the object-store Worker (packages/cloudflare; `wrangler dev`
#   serves http://localhost:8787). The browser worker always goes through it,
#   and signed read URLs point at it.
# R2_API_TOKEN: the Worker's bearer token (browser worker, scheduler in
#   Worker-only mode). Must match the Worker's .dev.vars / secret.
# R2_SIGNING_SECRET: HMAC key for signed read URLs (web app, scheduler).
#   Must match the Worker's. Generate with `openssl rand -hex 32`.
R2_WORKER_URL=http://localhost:8787
R2_API_TOKEN=
R2_SIGNING_SECRET=
# S3 credentials for the scheduler. Leave R2_ACCESS_KEY_ID empty locally to run
# the scheduler in Worker-only mode (one bucket: the Worker's).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Local S3 (MinIO, `--profile storage`, S3 API on :5204, console on :5205).
# Leave R2_ENDPOINT blank to talk to real R2.
R2_ENDPOINT=
R2_USE_PATH_STYLE=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Proxy (services/proxy, optional)
# ---------------------------------------------------------------------------
# Where the web app reaches the proxy, and the key both sides share.
NEXT_PUBLIC_PROXY_URL=http://localhost:5202
PROXY_API_KEY=
# Optional: an outbound proxy for the browser worker's Captures.
# PROXY_URL=

# ---------------------------------------------------------------------------
# Marketing site
# ---------------------------------------------------------------------------
# NocoDB token for the forms on the marketing site.
NOCODB_API_TOKEN=

# ---------------------------------------------------------------------------
# Tests (optional)
# ---------------------------------------------------------------------------
# A real OpenAI key for suites that call a model. Never used outside tests.
TEST_OPENAI_API_KEY=
# Owner of the messages scripts/rabbitmq publishes by hand.
TEST_NOTIFICATIONS_USER_ID=

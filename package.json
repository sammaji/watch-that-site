{
    "name": "watchthatsite",
    "private": true,
    "version": "0.1.0",
    "packageManager": "pnpm@10.33.2",
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "lint": "gts lint",
        "lint:turbo": "turbo lint",
        "lint:all": "gts lint && turbo lint",
        "auth:generate": "pnpm exec better-auth generate --config ./packages/auth/src/config.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "fix": "gts fix && prettier --write ."
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "gts": "^7.0.0",
        "prettier": "^3.8.3",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-sql": "^0.20.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "turbo": "^2.9.7",
        "typescript": "^5.6.3"
    }
}
